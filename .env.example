# Copie para .env (ignorado pelo git). Valores abaixo são APENAS para desenvolvimento local.
# Em produção, segredos vêm do cofre de segredos, nunca de arquivo.

# Superusuário, usado somente por "npm run db:setup" para criar papéis e banco.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Senhas que o db:setup define para os papéis da aplicação.
ILPI_APP_PASSWORD=app_dev_local
ILPI_MIGRADOR_PASSWORD=migrador_dev_local

# Papel dono do schema, usado por "npm run db:migrar". O nome do banco vem daqui.
MIGRATOR_DATABASE_URL=postgres://ilpi_migrador:migrador_dev_local@localhost:5432/ilpi_dev

# Papel da aplicação: sem superusuário e sem BYPASSRLS.
DATABASE_URL=postgres://ilpi_app:app_dev_local@localhost:5432/ilpi_dev
