{
  "name": "ilpi-medicacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de medicação para casas de idosos (ILPI)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.mjs",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
